# Non-secret, per-project function config (Firebase CLI loads .env.<projectId>).
# PRODUCTION — fir-sample-aae4a.

# Appdata bucket of the openvidu-elastic-prod stack, auto-created by Terraform and
# captured from `bash scripts/oci/verify-oci-stack.sh prod` after the 2026-08-12 apply.
# OCI_endpoint.js throws on the production project if this is unset rather than falling
# back to the dev bucket — a loud failure beats prod recordings silently landing in the
# dev cluster's storage.
OCI_RECORDING_BUCKET=openvidu-elastic-prod-appdata-402213

# Serverless VPC connector that routes Postmark-calling functions through Cloud NAT so they leave
# from the reserved static IP postmark-egress-ip (35.226.111.222), which Postmark can allowlist.
# Created 2026-10-02 with router functions-nat-router / NAT functions-nat, us-central1, prod only —
# leave it unset on other projects (see commonService.postmarkEgress).
POSTMARK_VPC_CONNECTOR=functions-egress
