{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "lint": "eslint .",
    "test": "jest test/unit",
    "test:integration": "firebase emulators:exec --only firestore --project fir-sample-aae4a \"jest --runInBand --config jest.integration.config.js\"",
    "test:integration:safe": "firebase emulators:exec --only firestore --project fir-sample-aae4a --config firebase.throwaway.json \"jest --runInBand --config jest.integration.config.js\"",
    "ci:local": "bash scripts/ci-local.sh",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "verify:live": "node scripts/verify-live-pipeline.js",
    "verify:indexes": "bash scripts/verify-indexes.sh",
    "stage-test": "node scripts/stage-test.js",
    "test:invariants": "node test/invariants.js",
    "atc:validate-s1": "node scripts/validate-stage1-pending.js",
    "atc:report": "node scripts/atc-queue-report.js",
    "atc:backfill-missing-jobs": "node scripts/atc-backfill-missing-jobs.js",
    "atc:test-harness": "node scripts/atc-test-harness.js",
    "atc:monitor": "node scripts/atc-live-monitor.js",
    "atc:archive-onhold": "node scripts/archive-onhold-docs.js",
    "atc:pairing-audit": "node scripts/atc-pairing-crossqueue-audit.js",
    "atc:generation-preview": "node scripts/atc-generation-doc-preview.js",
    "atc:generate-for-queue": "node scripts/atc-generate-for-queue.js",
    "atc:validate-structure": "node scripts/atc-validate-structure.js",
    "atc:rollup-reconcile": "node scripts/atc-rollup-reconcile.js",
    "graph:refresh": "$(cat graphify-out/.graphify_python) scripts/graphify-refresh.py",
    "graph:query": "graphify query"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/logging": "^11.2.1",
    "@slack/client": "^5.0.2",
    "apn": "^2.2.0",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.10.0",
    "cors": "^2.8.5",
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^7.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "google-auth-library": "^10.6.2",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.3",
    "jsrsasign": "^11.1.0",
    "livekit-server-sdk": "^2.6.1",
    "postmark": "^4.0.5",
    "publitio_js_sdk": "^1.1.5",
    "razorpay": "^2.9.4",
    "readable-stream": "^4.7.0",
    "twilio": "^5.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "firebase-functions-test": "^3.1.0",
    "globals": "^16.2.0",
    "jest": "^30.4.2",
    "typescript-eslint": "^8.34.1"
  },
  "private": true
}
