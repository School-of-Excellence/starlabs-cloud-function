# Postmark server tokens (plain env vars, loaded by the Firebase CLI from functions/.env at deploy time).
# Source of truth: GitHub repository secrets with the same names — the deploy workflow writes .env from them.
# For a local deploy or the emulator, copy this file to functions/.env and fill in the values. Never commit .env.
POSTMARK_STARLABS_V1=
POSTMARK_STARLABS_V2=
POSTMARK_STARLABS_V3=
POSTMARK_STARLABS_V4=
POSTMARK_STARLABS_TEST=
