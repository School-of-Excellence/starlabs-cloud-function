{
  "functions": [
    {
      "source": "functions",
      "predeploy": [
        "node scripts/cicd/predeploy.js"
      ],
      "postdeploy": [
        "node scripts/cicd/postdeploy.js"
      ],
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "test",
        "docs",
        "jest.integration.config.js",
        "firebase.throwaway.json",
        "workflow.json",
        "Dockerfile",
        ".dockerignore"
      ]
    }
  ],
  "firestore": [
    {
      "database": "(default)",
      "indexes": "firestore.indexes.json"
    },
    {
      "database": "firestore-atc",
      "indexes": "firestore-atc.indexes.json"
    },
    {
      "database": "firestore-forms",
      "indexes": "firestore-forms.indexes.json"
    }
  ],
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}