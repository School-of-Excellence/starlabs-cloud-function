# CI/CD hooks config (master plan 2026-07-02). ONE-TIME SETUP per developer — EASIEST:
#   bash scripts/cicd/setscript.sh    ← prompts for the hub path (clones it if missing) and
#                                       fetches the token (gh variable → Secret Manager → paste)
# Manual alternative:
#   cp .env.cicd.example .env.cicd     # .env.cicd is gitignored — never commit it
#
# E2E_HUB_PATH — your local starlabs-e2e-tests checkout. The PREDEPLOY gate runs the Playwright
# no-retrigger-loop guard from there (emulator boots THIS repo's triggers). Deploys are BLOCKED
# without it — that is the point.
E2E_HUB_PATH=/Users/you/Documents/starlabs-e2e-tests

# POSTDEPLOY reporting → the release console's CF Board matrix ("deployed in dev/prod").
# Token: ask the operator (CONSOLE_INGEST_TOKEN — the shared low-privilege ingest bearer).
CONSOLE_INGEST_URL=https://us-central1-starlabs-cicd.cloudfunctions.net
CONSOLE_INGEST_TOKEN=
